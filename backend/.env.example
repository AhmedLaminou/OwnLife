# Copy to backend/.env and fill in. backend/.env is git-ignored: never commit it.

# --- Where your Markdown lives (the server only reads files under IMPORT_ROOT)
IMPORT_ROOT=C:/Users/you/Documents/Notes
JOURNAL_SYNC_PATH=C:/Users/you/Documents/Notes/{year}/{year}_JOURNAL.md
# {year} stands for a year: 2026/2026_JOURNAL.md now, 2027/2027_JOURNAL.md next year.
# The other .md files beside the journal are synced as notes. Both ways: saving in your
# editor reaches OwnLife within seconds, an edit in OwnLife is written into the file.
# FILE_SYNC=false stops watching ("Sync now" still works); FILE_SYNC_WRITEBACK=false makes
# OwnLife read-only towards your files. Previous versions: data/file-history (50 per file).
FILE_SYNC=true
FILE_SYNC_WRITEBACK=true
FILE_HISTORY_KEEP=50

# --- AI
# cloud_then_local: free OpenRouter models, then local Ollama when offline or rate-limited.
# local: Ollama only (private, slower). cloud: OpenRouter only. off: no AI.
AI_MODE=cloud_then_local
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Free models, in fallback order (checked 2026-10-02). `python -m app.doctor --online`
# tells you if one disappears from the catalog.
OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,qwen/qwen3.8-27b:free,google/gemma-4-31b-it:free
# Leave empty to follow your account's privacy settings at openrouter.ai/settings/privacy.
# "deny" excludes providers that store prompts — which excludes most free endpoints.
OPENROUTER_DATA_COLLECTION=

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:4b-instruct-2507-q4_K_M
EMBEDDINGS_PROVIDER=ollama
OLLAMA_EMBED_MODEL=embeddinggemma

# --- ActivityWatch (optional automatic tracking, activitywatch.net)
ACTIVITYWATCH_URL=http://127.0.0.1:5600
# Minutes between automatic syncs; 0 = only the Sync button.
ACTIVITYWATCH_AUTOSYNC_MINUTES=15

# --- Server
HOST=127.0.0.1
PORT=8000
# development: auto-reload and /api/docs. production: neither.
ENVIRONMENT=development
